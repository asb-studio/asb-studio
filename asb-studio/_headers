# ==========================================================================
# Cloudflare Pages headers
# --------------------------------------------------------------------------
# Cloudflare Pages reads this file; it does not read vercel.json, which is why
# that file is gone.
#
# THE CACHING RULES ARE NOT COSMETIC. If a browser caches src/main.js, one
# person sees the new studio after a push and the other sees the old one, and
# neither can tell why. The app is never cached; the bundled libraries and the
# font, which only change when they are replaced by hand, are cached hard.
# ==========================================================================

/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: SAMEORIGIN

/
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

/src/*
  Cache-Control: no-cache, must-revalidate

/data/*
  Cache-Control: no-cache, must-revalidate

/vendor/*
  Cache-Control: public, max-age=604800

/webfonts/*
  Cache-Control: public, max-age=2592000

/logos/*
  Cache-Control: public, max-age=604800
